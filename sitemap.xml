  <video:video><video:thumbnail_loc>https://globetape.github.io/thumbs/lesotho.jpg</video:thumbnail_loc><video:title>Lesotho: The Country Inside South Africa</video:title><video:description>Why is Lesotho inside South Africa? It's a whole independent country, about the size of Belgium, completely surrounded by a single neighbour. Even its lowest point sits 1,400 metres above sea level: a world record.</video:description><video:player_loc>https://www.youtube.com/embed/IJLDw3Rc5ns</video:player_loc><video:duration>36</video:duration><video:publication_date>2026-11-19T18:00:00Z</video:publication_date><video:family_friendly>yes</video:family_friendly></video:video></url>
